# Include into the zabor-i-naves.ru server block (443), e.g.:
#   include /etc/nginx/conf.d/zabor-i-naves-metrics.locations.conf;
# Requires /etc/nginx/conf.d/monitoring-key.conf (map $metrics_auth + zone metrics_limit).
# Replace 127.0.0.1:3001 with the site's named upstream if one is configured
# (per ЧТЗ §5.3 proxy through the same upstream the site uses).

location = /api/metrics {
    limit_except GET { deny all; }
    if ($metrics_auth = 0) { return 403; }
    limit_req zone=metrics_limit burst=5 nodelay;
    access_log /var/log/nginx/metrics_access.log metrics_minimal;
    proxy_pass http://127.0.0.1:3001/api/metrics;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /metrics/tracking {
    limit_except GET { deny all; }
    if ($metrics_auth = 0) { return 403; }
    limit_req zone=metrics_limit burst=5 nodelay;
    access_log /var/log/nginx/metrics_access.log metrics_minimal;
    proxy_pass http://127.0.0.1:3001/api/metrics/tracking;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /metrics/content {
    limit_except GET { deny all; }
    if ($metrics_auth = 0) { return 403; }
    limit_req zone=metrics_limit burst=5 nodelay;
    access_log /var/log/nginx/metrics_access.log metrics_minimal;
    proxy_pass http://127.0.0.1:3001/api/metrics;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /metrics/node {
    limit_except GET { deny all; }
    if ($metrics_auth = 0) { return 403; }
    limit_req zone=metrics_limit burst=5 nodelay;
    access_log /var/log/nginx/metrics_access.log metrics_minimal;
    proxy_pass http://127.0.0.1:9100/metrics;
}

location ^~ /metrics/postgres {
    limit_except GET { deny all; }
    if ($metrics_auth = 0) { return 403; }
    limit_req zone=metrics_limit burst=5 nodelay;
    access_log /var/log/nginx/metrics_access.log metrics_minimal;
    proxy_pass http://127.0.0.1:9187/metrics;
}
