# =============================================================================
# SECURITY WARNING: NEVER commit real secrets to git!
# =============================================================================
# This file is a template. Copy it to .env and fill in real values.
# Real secrets should only exist on your local machine or production server.
# =============================================================================

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/fences"
POSTGRES_PASSWORD="password"

# Redis
REDIS_URL="redis://localhost:6379"

# =============================================================================
# AUTHENTICATION SECRETS (REQUIRED)
# =============================================================================

# NextAuth.js Secret - Used to sign and encrypt JWT tokens
# Generate with: openssl rand -base64 32
# WARNING: Changing this will invalidate all active user sessions!
NEXTAUTH_SECRET="REPLACE_WITH_REAL_SECRET_RUN_openssl_rand_-base64_32"
NEXTAUTH_URL="http://localhost:3001"

# Cron Jobs Secret - Used to authorize cron job requests to /api/cron/* endpoints
# Generate with: openssl rand -base64 32
# WARNING: After changing, update cron job configuration on your server!
CRON_SECRET="REPLACE_WITH_REAL_SECRET_RUN_openssl_rand_-base64_32"

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# =============================================================================
# NOTIFICATIONS (Telegram)
# =============================================================================

TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# =============================================================================
# INTEGRATIONS
# =============================================================================

# Google ReCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-site-key"
RECAPTCHA_SECRET_KEY="your-secret-key"

# Analytics (safe to commit - public keys)
NEXT_PUBLIC_YANDEX_METRIKA_ID="your-id"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="your-id"

# Yandex Maps API
NEXT_PUBLIC_YANDEX_MAPS_API_KEY="your-api-key"
