# =============================================================================
# SECURITY WARNING: NEVER commit real secrets to git!
# =============================================================================
# This file is a template. Copy it to .env and fill in real values.
# Real secrets should only exist on your local machine or production server.
# =============================================================================

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/fences
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Redis
# Redis Password (REQUIRED for production)
# Generate with: openssl rand -base64 32
# IMPORTANT: Use Docker secrets in production (./secrets/redis_password), never commit to git!
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME_REPLACE_WITH_REAL_PASSWORD

# =============================================================================
# AUTHENTICATION SECRETS (REQUIRED)
# =============================================================================

# NextAuth.js Secret - Used to sign and encrypt JWT tokens
# Generate with: openssl rand -base64 32
# WARNING: Changing this will invalidate all active user sessions!
NEXTAUTH_SECRET=CHANGE_ME_REPLACE_WITH_REAL_SECRET
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron Jobs Secret - Used to authorize cron job requests to /api/cron/* endpoints
# Generate with: openssl rand -base64 32
# WARNING: After changing, update cron job configuration on your server!
CRON_SECRET=CHANGE_ME_REPLACE_WITH_REAL_SECRET

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=CHANGE_ME_your-app-password

# =============================================================================
# NOTIFICATIONS (Telegram)
# =============================================================================

TELEGRAM_BOT_TOKEN=CHANGE_ME_your-bot-token
TELEGRAM_CHAT_ID=CHANGE_ME_your-chat-id
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
# HTTP proxy for Telegram API (used when direct access to api.telegram.org is blocked)
# Example: http://127.0.0.1:1080 (Xray local proxy)
# Leave empty for direct connection
TELEGRAM_PROXY_URL=

# =============================================================================
# INTEGRATIONS
# =============================================================================

# Site URL (for SEO and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://zabor-i-naves.ru

# Google ReCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=CHANGE_ME_your-site-key
RECAPTCHA_SECRET_KEY=CHANGE_ME_your-secret-key

# Analytics (safe to commit - public keys)
NEXT_PUBLIC_YANDEX_METRIKA_ID=CHANGE_ME_your-id
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=CHANGE_ME_your-id

# Google Search Console verification code (from HTML meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=CHANGE_ME_your-verification-code

# Yandex Maps API
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=CHANGE_ME_your-api-key

# Yandex Business API (for reviews integration)
# Get your organization ID from Yandex.Maps URL: https://yandex.ru/maps/org/YOUR_ORG_NAME/
# IMPORTANT: Also add NEXT_PUBLIC_YANDEX_ORG_ID to .env for client-side widgets
NEXT_PUBLIC_YANDEX_ORG_ID=154197841574
YANDEX_ORG_ID=154197841574
YANDEX_API_KEY=CHANGE_ME_yandex-business-api-key
NEXT_PUBLIC_YANDEX_ORG_URL=https://yandex.ru/maps/org/154197841574/

# =============================================================================
# MONITORING (docker-compose.monitoring.yml)
# =============================================================================

# Grafana admin password (REQUIRED - no default for security)
# Generate with: openssl rand -base64 32
# IMPORTANT: Also update docker/.htpasswd with: htpasswd -Bbn admin YOUR_PASSWORD > docker/.htpasswd
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password
