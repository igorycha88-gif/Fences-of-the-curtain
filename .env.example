DATABASE_URL="postgresql://postgres:password@localhost:5432/fences"
REDIS_URL="redis://localhost:6379"

# NextAuth.js Secret (REQUIRED)
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a real secret in production, never commit secrets to git!
# In production use environment variables:
# - Vercel: Environment Variables in project settings
# - Docker: docker-compose secrets or -e flag
# - Kubernetes: Secrets
NEXTAUTH_SECRET="REPLACE_WITH_REAL_SECRET_RUN_openssl_rand_-base64_32"
NEXTAUTH_URL="http://localhost:3001"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-site-key"
RECAPTCHA_SECRET_KEY="your-secret-key"

NEXT_PUBLIC_YANDEX_METRIKA_ID="your-id"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="your-id"

NEXT_PUBLIC_YANDEX_MAPS_API_KEY="your-api-key"
