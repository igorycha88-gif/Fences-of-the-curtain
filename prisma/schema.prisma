generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                    @id @default(cuid())
  email                String                    @unique
  name                 String?
  password             String
  role                 Role                      @default(MANAGER)
  phone                String?
  active               Boolean                   @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  estimates            FenceEstimate[]
  gateEstimates        GateEstimate[]    @relation("GateEstimateEditedBy")
  gateEstimateOrders   GateEstimate[]
  multiEstimates       MultiFenceEstimate[]
  ordersAssigned       Order[]                   @relation("AssignedOrders")
  priceHistory         PriceHistory[]
  referenceChangeLogs  ReferenceChangeLog[]
  notificationSettings UserNotificationSettings?
  auditLogs            AuditLog[]
  trussCalculations    TrussCalculation[]
}

model FenceMaterial {
  id                   String                @id @default(cuid())
  name                 String
  category             FenceMaterialCategory
  unit                 String
  basePrice            Float
  description          String?
  image                String?
  thickness            Float?
  width                Float?
  height               Float?
  coating              String?
  availableHeights     Json?
  availableThicknesses Float[]
  thicknessPrices      Json?
  active               Boolean               @default(true)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  fenceTypeId          String?
  fenceType            FenceType?            @relation(fields: [fenceTypeId], references: [id])

  @@index([category])
  @@index([active])
  @@index([fenceTypeId])
}

model CanopyMaterial {
  id        String                 @id @default(cuid())
  name      String
  category  CanopyMaterialCategory
  unit      String
  basePrice Float
  thickness Float?
  color     String?
  image     String?
  active    Boolean                @default(true)
  sortOrder Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model FenceType {
  id             String          @id @default(cuid())
  name           String
  description    String?
  image          String?
  difficultyCoef Float           @default(1.0)
  postSpacing    Int             @default(2500)
  defaultLagRows Int             @default(2)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  priority       Int             @default(0)
  estimates      FenceEstimate[]
  materials      FenceMaterial[]

  @@index([active])
  @@index([priority])
}

model PostType {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  sectionWidth         Float
  sectionHeight        Float
  wallThickness        Float
  pricePerMeter        Float
  image                String?
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  expirationDate       DateTime?
  validFrom            DateTime?
  length               Float
  priority             Int       @default(0)
  retailPricePerUnit   Float
  purchasePricePerUnit Float?
  forMesh              Boolean   @default(false)

  @@index([active])
  @@index([validFrom])
  @@index([expirationDate])
  @@index([length])
  @@index([priority])
  @@index([sectionWidth, sectionHeight, wallThickness])
  @@index([forMesh])
}

model MeshType {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  height               Float
  cellSize             Int
  wireThickness        Float
  coating              String
  retailPricePerUnit   Float
  purchasePricePerUnit Float?
  image                String?
  active               Boolean   @default(true)
  validFrom            DateTime?
  validUntil           DateTime?
  priority             Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([active])
  @@index([validUntil])
  @@index([coating])
  @@index([priority])
  @@index([height, cellSize, wireThickness, coating])
}

model LagType {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  width                Float
  height               Float
  metalThickness       Float
  retailPricePerUnit   Float
  purchasePricePerUnit Float?
  image                String?
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  expirationDate       DateTime?
  validFrom            DateTime?
  priority             Int       @default(0)
  length               Int

  @@index([active])
  @@index([length])
  @@index([validFrom])
  @@index([expirationDate])
  @@index([priority])
  @@index([width, height, metalThickness, length])
}

model CanopyType {
  id           String   @id @default(cuid())
  name         String
  description  String?
  image        String?
  areaCoef     Float    @default(1.0)
  materialCoef Float    @default(1.0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkPrice {
  id           String   @id @default(cuid())
  name         String
  category     String
  pricePerUnit Float
  unit         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                 String              @id @default(cuid())
  clientName         String
  phone              String
  email              String?
  serviceType        String
  parameters         Json
  calculatedCost     Float
  status             OrderStatus         @default(NEW)
  managerComment     String?
  assignedTo         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  statusHistory      Json?
  estimateId         String?             @unique
  cancellationReason String?
  completionDate     DateTime?
  measurementAddress String?
  measurementDate    DateTime?
  multiEstimateId    String?
  active             Boolean             @default(true)
  adminEstimateId    String?             @unique
  adminEstimate      FenceEstimate?      @relation("OrderAdminEstimate", fields: [adminEstimateId], references: [id])
  assignedUser       User?               @relation("AssignedOrders", fields: [assignedTo], references: [id])
  estimate           FenceEstimate?      @relation("OrderEstimate", fields: [estimateId], references: [id])
  multiEstimate      MultiFenceEstimate? @relation(fields: [multiEstimateId], references: [id])
  gateEstimateId      String?             @unique
  gateEstimate        GateEstimate?       @relation("OrderGateEstimate", fields: [gateEstimateId], references: [id])
  adminGateEstimateId String?             @unique
  adminGateEstimate   GateEstimate?       @relation("OrderAdminGateEstimate", fields: [adminGateEstimateId], references: [id])

  @@index([status])
  @@index([estimateId])
  @@index([multiEstimateId])
  @@index([measurementDate])
  @@index([cancellationReason])
  @@index([completionDate])
  @@index([active])
  @@index([gateEstimateId])
  @@index([adminGateEstimateId])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  category    String
  type        String?
  description String?
  images      Json
  cost        Float?
  showCost    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  text      String
  rating    Int
  image     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageContent {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        Json
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  category       String?
  coverImage     String?
  isActive       Boolean  @default(true)
  priceRange     String?
  sortOrder      Int      @default(0)
}

model BlogPost {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  excerpt        String?
  content        Json
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Panel3D {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  panelHeight          Float
  panelWidth           Float
  panelArea            Float?
  rodDiameter          Float
  cellWidth            Float
  cellHeight           Float
  purchasePricePerUnit Float?
  retailPricePerUnit   Float
  image                String?
  active               Boolean   @default(true)
  validFrom            DateTime?
  validUntil           DateTime?
  priority             Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model PriceHistory {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fieldName  String
  oldValue   String
  newValue   String
  changedBy  String
  changedAt  DateTime @default(now())
  user       User     @relation(fields: [changedBy], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  oldValues  Json?
  newValues  Json?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ReferenceChangeLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fieldName  String
  oldValue   Json?
  newValue   Json?
  changedBy  String
  changedAt  DateTime @default(now())
  user       User     @relation(fields: [changedBy], references: [id])

  @@index([entityType, entityId])
  @@index([changedAt])
}

model UserNotificationSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailNotifications    Boolean  @default(true)
  telegramNotifications Boolean  @default(false)
  telegramChatId        String?
  notifyNewOrder        Boolean  @default(true)
  notifyStatusChange    Boolean  @default(true)
  notifyAssignment      Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])
}

model ProfnastilType {
  id                          String    @id @default(cuid())
  name                        String
  description                 String?
  metalThickness              Float
  fullWidth                   Int
  usefulWidth                 Int
  length                      Int
  coating                     String
  color                       String?
  purchasePricePerUnit        Float?
  retailPricePerUnit          Float
  validFrom                   DateTime?
  validUntil                  DateTime?
  active                      Boolean   @default(true)
  image                       String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  priority                    Int       @default(0)
  purchasePricePerLinearMeter Float?

  @@unique([name, metalThickness, coating, color], name: "profnastil_unique_combination")
  @@index([active])
  @@index([validUntil])
  @@index([coating])
  @@index([name])
  @@index([priority])
}

model PicketProfileType {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  picketTypes PicketType[]

  @@index([active])
  @@index([sortOrder])
}

model PicketCoating {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  picketTypes PicketType[]

  @@index([active])
  @@index([sortOrder])
}

model PicketType {
  id                   String            @id @default(cuid())
  name                 String
  description          String?
  metalThickness       Float
  width                Int
  length               Int
  color                String?
  validFrom            DateTime?
  validUntil           DateTime?
  active               Boolean           @default(true)
  image                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  priority             Int               @default(0)
  purchasePricePerUnit Float?
  retailPricePerUnit   Float
  profileTypeId        String
  coatingId            String
  picketCoatingType    PicketCoating     @relation(fields: [coatingId], references: [id])
  picketProfile        PicketProfileType @relation(fields: [profileTypeId], references: [id])

  @@unique([name, metalThickness, coatingId, color], name: "picket_unique_combination")
  @@index([active])
  @@index([validUntil])
  @@index([coatingId])
  @@index([name])
  @@index([priority])
  @@index([profileTypeId])
  @@index([length])
}

model GateType {
  id             String    @id @default(cuid())
  name           String
  description    String?
  type           String
  metalThickness Float
  sectionWidth   Float
  sectionHeight  Float
  gateHeight     Float
  gateLength     Float
  retailPrice    Float
  purchasePrice  Float?
  image          String?
  active         Boolean   @default(true)
  validFrom      DateTime?
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  priority       Int       @default(0)

  @@index([active])
  @@index([type])
  @@index([validFrom])
  @@index([expirationDate])
  @@index([priority])
  @@index([sectionWidth, sectionHeight, metalThickness, gateLength])
}

model WicketType {
  id             String    @id @default(cuid())
  name           String
  description    String?
  metalThickness Float
  sectionWidth   Float
  sectionHeight  Float
  wicketHeight   Float
  wicketLength   Float
  retailPrice    Float
  purchasePrice  Float?
  image          String?
  active         Boolean   @default(true)
  validFrom      DateTime?
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  priority       Int       @default(0)

  @@index([active])
  @@index([validFrom])
  @@index([expirationDate])
  @@index([priority])
  @@index([sectionWidth, sectionHeight, metalThickness, wicketLength])
}

model MultiFenceEstimate {
  id                String          @id @default(cuid())
  totalMaterials    Float
  totalInstallation Float
  grandTotal        Float
  estimatesCount    Int             @default(1)
  userId            String?
  sessionId         String?
  userAgent         String?
  ipAddress         String?
  city              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  estimates         FenceEstimate[]
  user              User?           @relation(fields: [userId], references: [id])
  orders            Order[]

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([city])
}

model FenceEstimate {
  id                       String              @id @default(cuid())
  fenceTypeId              String
  length                   Float
  height                   Float
  lagRows                  Int
  postsTotal               Float
  lagsTotal                Float
  profnastilTotal          Float
  installationTotal        Float
  materialsTotal           Float
  grandTotal               Float
  items                    Json
  userId                   String?
  sessionId                String?
  userAgent                String?
  ipAddress                String?
  createdAt                DateTime            @default(now())
  mountingHardwareTotal    Float               @default(0)
  coating                  String              @default("POLYMER_SINGLE")
  gateInstallationTotal    Float               @default(0)
  gateLength               Int?
  gateHeight               Int?
  gateNomenclatureId       String?
  gateNomenclatureName     String?
  gateTotal                Float               @default(0)
  gateType                 String?
  hasGate                  Boolean             @default(false)
  hasWicket                Boolean             @default(false)
  wicketInstallationTotal  Float               @default(0)
  wicketNomenclatureId     String?
  wicketNomenclatureName   String?
  wicketTotal              Float               @default(0)
  wicketWidth              Int?
  wicketHeight             Int?
  city                     String?
  panel3dId                String?
  panel3dInstallationTotal Float               @default(0)
  panel3dNomenclatureName  String?
  panel3dTotal             Float               @default(0)
  picketNomenclatureId     String?
  picketNomenclatureName   String?
  picketTotal              Float               @default(0)
  picketStep               Int?
  picketMountingType       String?
  picketProfileType        String?
  picketCoatingName        String?
  multiEstimateId          String?
  active                   Boolean             @default(true)
  editComment              String?
  editedAt                 DateTime?
  editedByAdminId          String?
  isEditedByAdmin          Boolean             @default(false)
  manualQuantityOverrides  Json?
  sourceEstimateId         String?
  meshId                   String?
  meshInstallationTotal    Float               @default(0)
  meshNomenclatureName     String?
  meshTotal                Float               @default(0)
  hasAutomation              Boolean  @default(false)
  automationNomenclatureId   String?
  automationNomenclatureName String?
  automationTotal            Float   @default(0)
  automationInstallationTotal Float  @default(0)
  fenceType                FenceType           @relation(fields: [fenceTypeId], references: [id])
  multiEstimate            MultiFenceEstimate? @relation(fields: [multiEstimateId], references: [id])
  sourceEstimate           FenceEstimate?      @relation("AdminEstimateEdit", fields: [sourceEstimateId], references: [id])
  adminEdits               FenceEstimate[]     @relation("AdminEstimateEdit")
  user                     User?               @relation(fields: [userId], references: [id])
  adminOrder               Order?              @relation("OrderAdminEstimate")
  order                    Order?              @relation("OrderEstimate")

  @@index([fenceTypeId])
  @@index([userId])
  @@index([createdAt])
  @@index([sessionId])
  @@index([city])
  @@index([multiEstimateId])
  @@index([isEditedByAdmin])
  @@index([sourceEstimateId])
  @@index([editedByAdminId])
  @@index([active])
}

model GateEstimate {
  id                     String   @id @default(cuid())
  height                 Float
  needsInstallation      Boolean  @default(false)
  materialsTotal         Float
  installationTotal      Float
  grandTotal             Float
  items                  Json
  userId                 String?
  sessionId              String?
  userAgent              String?
  ipAddress              String?
  city                   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  active                 Boolean   @default(true)
  isEditedByAdmin        Boolean   @default(false)
  editedByAdminId        String?
  editedAt               DateTime?
  editComment            String?
  manualQuantityOverrides Json?
  sourceEstimateId       String?

  user              User?        @relation(fields: [userId], references: [id])
  editedByAdmin     User?        @relation("GateEstimateEditedBy", fields: [editedByAdminId], references: [id])
  sourceEstimate    GateEstimate?  @relation("GateAdminEstimateEdit", fields: [sourceEstimateId], references: [id])
  adminEdits        GateEstimate[] @relation("GateAdminEstimateEdit")
  order             Order?       @relation("OrderGateEstimate")
  adminOrder        Order?       @relation("OrderAdminGateEstimate")

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([city])
  @@index([isEditedByAdmin])
  @@index([sourceEstimateId])
  @@index([editedByAdminId])
  @@index([active])
}

model MountingHardware {
  id                String                     @id @default(cuid())
  name              String
  description       String?
  purchasePrice     Float?
  retailPrice       Float
  validUntil        DateTime?
  active            Boolean                    @default(true)
  sortOrder         Int                        @default(0)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  calculationMethod String?
  calculationValue  Float?
  useInCalculator   Boolean                    @default(false)
  relations         MountingHardwareRelation[]

  @@index([active])
  @@index([validUntil])
  @@index([sortOrder])
  @@index([useInCalculator])
}

model MountingHardwareRelation {
  id                 String           @id @default(cuid())
  mountingHardwareId String
  referenceType      String
  referenceId        String
  createdAt          DateTime         @default(now())
  mountingHardware   MountingHardware @relation(fields: [mountingHardwareId], references: [id], onDelete: Cascade)

  @@unique([mountingHardwareId, referenceType, referenceId])
  @@index([referenceType])
  @@index([referenceId])
}

model Work {
  id              String         @id @default(cuid())
  name            String
  description     String?
  category        String
  unit            String
  price           Float
  useInCalculator Boolean        @default(false)
  sortOrder       Int            @default(0)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  relations       WorkRelation[]

  @@index([active])
  @@index([useInCalculator])
  @@index([category])
  @@index([sortOrder])
}

model WorkRelation {
  id            String   @id @default(cuid())
  workId        String
  fenceType     String?
  createdAt     DateTime @default(now())
  referenceId   String?
  referenceType String?
  work          Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, fenceType, referenceType, referenceId])
  @@index([fenceType])
  @@index([referenceType])
  @@index([referenceId])
}

model ContactInfo {
  id              String   @id @default(cuid())
  address         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  workHoursMonFri String   @default("")
  workHoursSat    String   @default("")
  workHoursSun    String   @default("")
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model RateLimitConfig {
  id          String   @id @default("auth")
  maxAttempts Int      @default(5)
  windowMs    Int      @default(900000)
  updatedAt   DateTime @updatedAt
}

model NotificationRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model CookieConsent {
  id           String   @id @default(cuid())
  sessionId    String?  @unique
  consentGiven Boolean  @default(false)
  analytics    Boolean  @default(false)
  consentText  String   @default("Мы используем файлы cookie для улучшения работы сайта и аналитики.")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sessionId])
  @@index([createdAt])
  @@index([consentGiven])
  @@map("cookie_consents")
}

enum Role {
  ADMIN
  MANAGER
  CONTENT_MANAGER
}

enum FenceMaterialCategory {
  PROFNASTIL
  SHAKHETNIK
  MESH
  PANELS_3D
  POSTS
  LAGS
  GATES
  WICKETS
  FASTENERS
}

enum CanopyMaterialCategory {
  POLYCARBONATE
  PROFNASTIL
  METAL_TILE
  PROFILE
  FASTENERS
  WATER_SYSTEM
}

enum OrderStatus {
  NEW
  ESTIMATE_APPROVAL
  MEASUREMENT
  PRODUCTION
  INSTALLATION
  COMPLETED
  CANCELLED
}

enum TrussProfileCategory {
  POST
  CROSSBEAM
  STRUT
  ARCH
}

enum CanopyRoofType {
  SINGLE_SLOPE
  DOUBLE_SLOPE
  ARCH
  SINGLE_SLOPE_CURVED
}

model TrussProfileType {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  category              TrussProfileCategory
  sectionWidth          Float
  sectionHeight         Float
  wallThickness         Float
  length                Float    @default(6.0)
  steelGrade            String   @default("S235")
  yieldStrength         Float    @default(235)
  sectionArea           Float
  momentOfInertiaX      Float
  momentOfInertiaY      Float
  sectionModulusX       Float
  sectionModulusY       Float
  radiusOfGyrationX     Float
  radiusOfGyrationY     Float
  weightPerMeter        Float
  retailPricePerMeter   Float
  purchasePricePerMeter Float?
  retailPricePerUnit    Float    @default(0)
  purchasePricePerUnit  Float?
  image                 String?
  isActive              Boolean  @default(true)
  priority              Int      @default(0)
  validFrom             DateTime?
  expirationDate        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  calcsPost        TrussCalculation[] @relation("CalcPost")
  calcsCrossbeam   TrussCalculation[] @relation("CalcCrossbeam")
  calcsTopChord    TrussCalculation[] @relation("CalcTopChord")
  calcsStrut       TrussCalculation[] @relation("CalcStrut")
  calcsArch        TrussCalculation[] @relation("CalcArch")

  @@index([category])
  @@index([isActive])
  @@index([priority])
  @@index([sectionWidth, sectionHeight, wallThickness])
  @@index([validFrom])
  @@index([expirationDate])
}

model TrussRoofCovering {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  weightPerSqm        Float
  thickness           Float?
  width               Float?
  usefulWidth         Float?
  standardLength      Float?
  coating             String?
  coatingType         String?
  color               String?
  retailPricePerSqm   Float
  purchasePricePerSqm Float?
  image               String?
  isActive            Boolean  @default(true)
  priority            Int      @default(0)
  validFrom           DateTime?
  expirationDate      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  calculations TrussCalculation[]

  @@index([isActive])
  @@index([priority])
  @@index([validFrom])
  @@index([expirationDate])
}

model TrussCalculation {
  id                   String             @id @default(cuid())
  name                 String?
  canopyType           CanopyRoofType
  width                Float
  length               Float
  ridgeHeight          Float
  wallHeight           Float?
  trussSpacing         Float
  roofCoveringId       String
  snowRegion           String             @default("III")
  postProfileId        String
  crossbeamProfileId   String
  topChordProfileId    String?
  strutProfileId       String
  archProfileId        String?
  snowLoad             Float
  windLoad             Float
  deadLoad             Float
  totalLoad            Float
  snowLoadNormative    Float    @default(0)
  windLoadNormative    Float    @default(0)
  deadLoadNormative    Float    @default(0)
  totalLoadNormative   Float    @default(0)
  loadPerTruss         Float
  safetyFactor         Float
  trussGeometry        Json
  materialList         Json
  profileRecommendations Json?
  svgDrawing           String?  @default("")
  snowCoeffMu          Float    @default(1.0)
  windCoeffC           Float    @default(0.3)
  windHeightCoeff      Float    @default(0.5)
  slopeAngle           Float    @default(0)
  isActive             Boolean            @default(true)
  createdBy            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  roofCovering    TrussRoofCovering @relation(fields: [roofCoveringId], references: [id])
  postProfile     TrussProfileType  @relation("CalcPost", fields: [postProfileId], references: [id])
  crossbeamProfile TrussProfileType @relation("CalcCrossbeam", fields: [crossbeamProfileId], references: [id])
  topChordProfile  TrussProfileType? @relation("CalcTopChord", fields: [topChordProfileId], references: [id])
  strutProfile    TrussProfileType  @relation("CalcStrut", fields: [strutProfileId], references: [id])
  archProfile     TrussProfileType? @relation("CalcArch", fields: [archProfileId], references: [id])
  user            User?             @relation(fields: [createdBy], references: [id])

   @@index([canopyType])
  @@index([createdBy])
  @@index([createdAt])
  @@index([isActive])
}

model AutomationType {
  id             String    @id @default(cuid())
  name           String
  description    String?
  retailPrice    Float
  purchasePrice  Float?
  image          String?
  active         Boolean   @default(true)
  validFrom      DateTime?
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  priority       Int       @default(0)

  @@index([active])
  @@index([validFrom])
  @@index([expirationDate])
  @@index([priority])
  @@index([name])
}

model SeoKeyword {
  id           String       @id @default(cuid())
  keyword      String
  searchEngine String       @default("google")
  pagePath     String?
  group        String?
  active       Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  positions    SeoPosition[]

  @@unique([keyword, searchEngine])
  @@index([active])
  @@index([searchEngine])
  @@index([group])
  @@index([keyword])
  @@map("seo_keywords")
}

model SeoPosition {
  id        String     @id @default(cuid())
  keywordId String
  position  Int
  url       String?
  title     String?
  snippet   String?
  found     Boolean    @default(true)
  checkedAt DateTime   @default(now())
  createdAt DateTime   @default(now())
  keyword   SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId])
  @@index([checkedAt])
  @@index([keywordId, checkedAt])
  @@index([found])
  @@map("seo_positions")
}
