FROM node:20-bullseye-slim

WORKDIR /app

# Workaround (06.09.2026): bullseye LTS завершён 31.08.2026 — из пула
# bullseye-security (arm64) удалены libexpat1/libgbm1/libavahi-*, но индекс
# всё ещё ссылается на них → 404 и падение apt. Все зависимости сборки
# доступны в bullseye main, поэтому отключаем security-репозиторий.
RUN sed -i '/bullseye-security/d' /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fontconfig \
    fonts-dejavu-core \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    libwayland-client0 \
    fonts-noto-color-emoji \
    fonts-freefont-ttf \
    fonts-unifont \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000
ENV NODE_OPTIONS="--max-old-space-size=1024"

RUN mkdir -p /app/public/uploads/portfolio

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["/bin/sh", "/opt/entrypoint.dev.sh"]
