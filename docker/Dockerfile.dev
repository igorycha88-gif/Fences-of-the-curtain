FROM node:20-bullseye-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    fontconfig \
    fonts-dejavu-core \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    libwayland-client0 \
    fonts-noto-color-emoji \
    fonts-freefont-ttf \
    fonts-unifont \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000
ENV NODE_OPTIONS="--max-old-space-size=512"

COPY package.json package-lock.json ./

RUN npm install --legacy-peer-deps && npm cache clean --force

COPY . .

RUN npx prisma generate

RUN node -e "import('cloakbrowser').then(m => m.ensureBinary()).then(() => console.log('CloakBrowser binary ready')).catch(e => console.warn('CloakBrowser binary download skipped:', e.message))"

RUN mkdir -p /app/public/uploads/portfolio

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["npm", "run", "dev"]
