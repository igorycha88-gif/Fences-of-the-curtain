FROM node:20-bullseye-slim

WORKDIR /app

ENV NODE_ENV=development

COPY package.json package-lock.json* ./

RUN npm install --legacy-peer-deps

COPY prisma ./prisma
COPY tsconfig.json next.config.js ./
RUN npx prisma generate

COPY . .

EXPOSE 3001

ENV HOSTNAME="0.0.0.0"
ENV PORT=3001

CMD ["npm", "run", "dev"]
