# Dependencies
/node_modules
/.pnp
.pnp.js

# Docker cache (generated by Next.js)
.cache/

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files
.env
.env*.local
.env.production
.env.dev

# Secrets (Docker secrets - NEVER commit these!)
secrets/

# Backup files created by rotate-secrets.sh - NEVER commit these!
.env.backup.*
.env.bak

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma
/prisma/*.db
/prisma/*.db-journal

# SSL
/ssl/*.pem
/ssl/*.key

# Grafana basic auth (contains password hashes - generate at deploy time)
docker/.htpasswd
docker/.htpasswd.example

# Monitoring configuration
.env.monitoring
prometheus.yml
prometheus/alert_rules.yml
prometheus/recording_rules.yml
grafana/provisioning/datasources/*.yml
grafana/provisioning/dashboards/*.yml

# Monitoring data
prometheus_data/
grafana_data/

# Logs
logs/
*.log

# IDEs
.idea/
.vscode/
*.swp
*.swo
