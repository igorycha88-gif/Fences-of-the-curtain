# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# IMPORTANT: Copy to .env.monitoring and set a STRONG password!
# Generate with: openssl rand -base64 32
# Also update docker/.htpasswd: htpasswd -Bbn admin YOUR_PASSWORD > docker/.htpasswd
# =============================================================================

# Grafana Admin Password (REQUIRED - no default in production)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password

# Grafana Security
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ALLOW_EMBEDDING=true
GF_USERS_ALLOW_SIGN_UP=false

# Prometheus Configuration
PROMETHEUS_RETENTION=200h
PROMETHEUS_STORAGE_SIZE=10GB

# Alerting Configuration
ALERTMANAGER_ENABLED=false
ALERTMANAGER_URL=http://alertmanager:9093

# Email/Telegram Notifications (для будущей интеграции)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=your-email@gmail.com
ALERT_EMAIL_SMTP_PASSWORD=CHANGE_ME_your-app-password

ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=CHANGE_ME_your-bot-token
ALERT_TELEGRAM_CHAT_ID=CHANGE_ME_your-chat-id
