name: Deploy to Production

on:
  push:
    branches: [master, main]
  workflow_dispatch:
    inputs:
      deploy_reason:
        description: 'Reason for deployment'
        required: false
        default: 'Manual deployment'
      description:
        description: 'Additional notes'
        required: false

env:
  APP_DIR: "/root/Fences-of-the-curtain"
  APP_NAME: "fences-app"
  PORT: "3001"
  BASE_URL: "http://localhost:3001"

permissions:
  contents: read

jobs:
  deploy-production:
    name: Deploy to Production
    runs-on: ubuntu-latest
    needs: []
    if: github.event_name == 'push' && github.ref == 'refs/heads/master' || github.event_name == 'workflow_dispatch'
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Deploy to Production VPS via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SSH_HOST || '37.143.13.196' }}
          username: root
          password: ${{ secrets.SSH_PASSWORD }}
          port: ${{ secrets.SSH_PORT || 22 }}
          script_stop: true
          command_timeout: 20m
          script: |
            set -e
            
            APP_DIR="/root/Fences-of-the-curtain"
            APP_NAME="fences-app"
            PORT="3001"
            BASE_URL="http://localhost:3001"
            LOG_DIR="/var/log/fences-deploy"
            DEPLOY_LOG="$LOG_DIR/deploy-production.log"
            DEPLOY_REASON="${{ github.event.inputs.deploy_reason || 'Push to master' }}"
            
            mkdir -p "$LOG_DIR" /var/log/fences-app
            
            log_deploy() {
              echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$DEPLOY_LOG"
            }
            
            cd $APP_DIR
            
            log_deploy "=== PRODUCTION DEPLOY STARTED ==="
            log_deploy "Initiator: ${GITHUB_ACTOR:-manual}"
            log_deploy "Branch: ${{ github.ref_name }}"
            log_deploy "Commit: ${{ github.sha }}"
            log_deploy "Reason: $DEPLOY_REASON"
            
            log_deploy "=== Checking environment ==="
            if [ ! -f .env ]; then
              log_deploy "ERROR: .env file not found!"
              exit 1
            fi
            
            log_deploy "=== Validating NEXTAUTH_SECRET ==="
            if grep -qE "your-super-secret-key|change-in-production|REPLACE_WITH_REAL_SECRET" .env; then
              log_deploy "ERROR: Invalid NEXTAUTH_SECRET found in .env!"
              exit 1
            fi
            log_deploy "✓ NEXTAUTH_SECRET is valid"
            
            log_deploy "=== Saving current state for rollback ==="
            PREVIOUS_COMMIT=$(git rev-parse HEAD 2>/dev/null || echo "none")
            BACKUP_TAG="prod-backup-$(date +%Y%m%d%H%M%S)"
            git tag "$BACKUP_TAG" 2>/dev/null || true
            log_deploy "Previous commit: $PREVIOUS_COMMIT"
            log_deploy "Backup tag: $BACKUP_TAG"
            
            log_deploy "=== Creating database backup ==="
            BACKUP_FILE="backup_prod_$(date +%Y%m%d_%H%M%S).sql"
            sudo -u postgres pg_dump -U postgres fences > "$BACKUP_FILE" || log_deploy "Warning: Backup failed, continuing..."
            if [ -f "$BACKUP_FILE" ]; then
              log_deploy "✓ Backup created: $BACKUP_FILE"
            fi
            
            log_deploy "=== Pulling latest changes ==="
            git fetch origin
            TARGET_COMMIT=$(git rev-parse origin/master)
            log_deploy "Target commit: $TARGET_COMMIT"
            
            git reset --hard origin/master
            
            log_deploy "=== Installing dependencies ==="
            npm install --legacy-peer-deps
            
            log_deploy "=== Generating Prisma Client ==="
            npx prisma generate
            
            log_deploy "=== Building application ==="
            npm run build
            
            log_deploy "=== Pushing schema changes ==="
            npx prisma db push --accept-data-loss
            
            log_deploy "=== Graceful zero-downtime restart with PM2 ==="
            if pm2 list | grep -q "$APP_NAME"; then
              log_deploy "Reloading existing process (zero-downtime)..."
              pm2 reload ecosystem.config.js --env production || pm2 restart ecosystem.config.js --env production
            else
              log_deploy "Starting new process..."
              pm2 start ecosystem.config.js --env production
            fi
            pm2 save
            
            log_deploy "=== Waiting for application to stabilize (20 seconds) ==="
            sleep 20
            
            log_deploy "=== Running comprehensive smoke tests ==="
            if ./scripts/smoke-test.sh "$BASE_URL"; then
              log_deploy "✓ All smoke tests passed"
              SMOKE_SUCCESS=1
            else
              log_deploy "✗ Smoke tests failed"
              SMOKE_SUCCESS=0
            fi
            
            if [ $SMOKE_SUCCESS -eq 0 ]; then
              log_deploy "=== DEPLOYMENT FAILED - INITIATING EMERGENCY ROLLBACK ==="
              
              log_deploy "=== Rolling back to previous commit: $PREVIOUS_COMMIT ==="
              git reset --hard "$PREVIOUS_COMMIT"
              
              log_deploy "=== Restoring from backup if available ==="
              if [ -f "$BACKUP_FILE" ]; then
                log_deploy "Restoring database from $BACKUP_FILE..."
                sudo -u postgres psql -U postgres -d fences < "$BACKUP_FILE" || log_deploy "Warning: Database restore failed"
              fi
              
              log_deploy "=== Reinstalling dependencies ==="
              npm install --legacy-peer-deps
              npx prisma generate
              
              log_deploy "=== Rebuilding application ==="
              npm run build
              
              log_deploy "=== Pushing previous schema ==="
              npx prisma db push --accept-data-loss
              
              log_deploy "=== Restarting with previous version ==="
              pm2 reload ecosystem.config.js --env production || pm2 restart ecosystem.config.js --env production
              
              log_deploy "=== Waiting for rollback to stabilize (20 seconds) ==="
              sleep 20
              
              log_deploy "=== Health check after rollback ==="
              ROLLBACK_SUCCESS=0
              for i in $(seq 1 10); do
                sleep 3
                if curl -sf --max-time 5 "$BASE_URL/" > /dev/null 2>&1; then
                  log_deploy "✓ Rollback health check passed on attempt $i!"
                  ROLLBACK_SUCCESS=1
                  break
                fi
              done
              
              if [ $ROLLBACK_SUCCESS -eq 1 ]; then
                log_deploy "=== ROLLBACK SUCCESSFUL ==="
                log_deploy "DEPLOY RESULT: rolled_back (from $PREVIOUS_COMMIT to $TARGET_COMMIT, back to $PREVIOUS_COMMIT)"
              else
                log_deploy "=== ROLLBACK FAILED - CRITICAL: MANUAL INTERVENTION REQUIRED ==="
                log_deploy "DEPLOY RESULT: rollback_failed"
              fi
              
              log_deploy "=== Final PM2 logs ==="
              pm2 logs $APP_NAME --lines 100 --nostream || true
              pm2 list
              
              git tag -d "$BACKUP_TAG" 2>/dev/null || true
              exit 1
            fi
            
            log_deploy "=== Cleaning up backup tag ==="
            git tag -d "$BACKUP_TAG" 2>/dev/null || true
            
            log_deploy "=== PRODUCTION DEPLOYMENT SUCCESSFUL ==="
            log_deploy "DEPLOY RESULT: success (from $PREVIOUS_COMMIT to $TARGET_COMMIT)"
            log_deploy "Deployment time: $(date '+%Y-%m-%d %H:%M:%S')"
            
            log_deploy "=== PM2 process status ==="
            pm2 list
            
            log_deploy "=== Application health ==="
            curl -I "$BASE_URL/" 2>&1 | head -5
            
            log_deploy "=== Cleanup old backups (7 days retention) ==="
            find "$APP_DIR" -name "backup_prod_*.sql" -mtime +7 -delete 2>/dev/null || true
            
            log_deploy "=== DEPLOY FINISHED ==="
